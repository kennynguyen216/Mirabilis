#version 450

// Lumen-lite checkpoint 2: sphere-trace one baked mesh distance field
// straight into the draw image.  Nothing else in the frame is consulted; the
// point is to see the volume the bake produced, placed in world space, from
// the real camera, before any of it is trusted as a GI fallback.

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, set = 0, binding = 0) uniform image2D image;
// Signed distance in world units, negative inside.  Texel (x, y, z) covers
// the matching cell of [boundsMin, boundsMax]; see scripts/bake_sdf.py.
layout(set = 0, binding = 1) uniform sampler3D sdfVolume;
// Reversed camera depth from the prepass, for comparing the trace against
// what the rasteriser drew.  0 where nothing was drawn.
layout(set = 0, binding = 2) uniform sampler2D prepassDepth;

layout(push_constant) uniform constants {
    mat4 inverseViewProjection;
    // xyz = camera position.
    vec4 cameraPosition;
    // xyz = world-space volume bounds, w = maximum march steps.
    vec4 boundsMin;
    // xyz = world-space volume bounds, w = view mode.
    vec4 boundsMax;
    // xy = draw extent, z = hit threshold in texels.
    vec4 extent;
} PushConstants;

const int ViewShaded = 0;
const int ViewNormals = 1;
const int ViewSteps = 2;
// Colour-coded agreement between the trace's hit distance and the raster
// depth: green within one voxel, yellow within three, red beyond; blue where
// the raster drew something the field missed, magenta the reverse.
const int ViewAgreement = 3;
// The same comparison as raw numbers for captures: r = distance error in
// voxels (or a negative category code), g = traced distance, b = raster.
const int ViewAgreementData = 4;

float volume_distance(vec3 worldPosition)
{
    vec3 uvw = (worldPosition - PushConstants.boundsMin.xyz) /
        (PushConstants.boundsMax.xyz - PushConstants.boundsMin.xyz);
    return textureLod(sdfVolume, uvw, 0.0).r;
}

vec3 volume_normal(vec3 p, vec3 texelSize)
{
    vec3 h = texelSize;
    vec3 gradient = vec3(
        volume_distance(p + vec3(h.x, 0, 0)) - volume_distance(p - vec3(h.x, 0, 0)),
        volume_distance(p + vec3(0, h.y, 0)) - volume_distance(p - vec3(0, h.y, 0)),
        volume_distance(p + vec3(0, 0, h.z)) - volume_distance(p - vec3(0, 0, h.z)));
    return normalize(gradient + vec3(1e-8));
}

// Slab test.  Returns false when the ray never enters the box.
bool intersect_box(vec3 origin, vec3 direction, out float tEnter, out float tExit)
{
    vec3 inverse = 1.0 / direction;
    vec3 t0 = (PushConstants.boundsMin.xyz - origin) * inverse;
    vec3 t1 = (PushConstants.boundsMax.xyz - origin) * inverse;
    vec3 tMin = min(t0, t1);
    vec3 tMax = max(t0, t1);
    tEnter = max(max(tMin.x, tMin.y), tMin.z);
    tExit = min(min(tMax.x, tMax.y), tMax.z);
    return tExit >= max(tEnter, 0.0);
}

vec3 heat(float t)
{
    return clamp(vec3(t * 2.0, 1.0 - abs(t * 2.0 - 1.0), 1.0 - t * 2.0),
        0.0, 1.0);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(PushConstants.extent.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    // Same reconstruction as render_debug.frag: the stored projection already
    // carries Vulkan's Y flip.  Depth is reversed, so the near plane is 1.
    vec2 ndc = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec4 nearPoint = PushConstants.inverseViewProjection * vec4(ndc, 1.0, 1.0);
    nearPoint.xyz /= nearPoint.w;
    vec3 origin = PushConstants.cameraPosition.xyz;
    vec3 direction = normalize(nearPoint.xyz - origin);

    // A plain sky gradient for misses, so the silhouette reads at a glance.
    vec3 color = mix(vec3(0.05, 0.05, 0.07), vec3(0.18, 0.22, 0.30),
        clamp(direction.y * 0.5 + 0.5, 0.0, 1.0));

    int mode = int(PushConstants.boundsMax.w + 0.5);
    int maxSteps = max(1, int(PushConstants.boundsMin.w + 0.5));
    vec3 boundsSize = PushConstants.boundsMax.xyz - PushConstants.boundsMin.xyz;
    vec3 texelSize = boundsSize / vec3(textureSize(sdfVolume, 0));
    float hitThreshold = PushConstants.extent.z *
        min(min(texelSize.x, texelSize.y), texelSize.z);

    float tEnter;
    float tExit;
    if (!intersect_box(origin, direction, tEnter, tExit)) {
        if (mode == ViewAgreement || mode == ViewAgreementData) {
            bool rasterHit = texelFetch(prepassDepth, pixel, 0).r > 0.0;
            if (mode == ViewAgreementData) {
                imageStore(image, pixel, vec4(rasterHit ? -1.0 : -3.0, 0.0, 0.0, 1.0));
                return;
            }
            if (rasterHit) {
                color = vec3(0.15, 0.3, 1.0);
            }
        }
        imageStore(image, pixel, vec4(color, 1.0));
        return;
    }

    // Faint tint over the volume's box, so a mesh placed away from where it
    // was expected still shows where the volume actually is.
    color += vec3(0.04, 0.03, 0.0);

    float t = max(tEnter, 0.0);
    bool hit = false;
    int steps = 0;
    for (; steps < maxSteps; ++steps) {
        vec3 p = origin + direction * t;
        float d = volume_distance(p);
        if (d < hitThreshold) {
            hit = true;
            break;
        }
        // Trilinear filtering can overstate the distance slightly near
        // sharp features; stepping a little short keeps the march from
        // tunnelling through them.
        t += max(d * 0.95, hitThreshold * 0.5);
        if (t > tExit) {
            break;
        }
    }

    if (mode == ViewAgreement || mode == ViewAgreementData) {
        float depth = texelFetch(prepassDepth, pixel, 0).r;
        bool rasterHit = depth > 0.0;
        float rasterDistance = 0.0;
        if (rasterHit) {
            vec4 world = PushConstants.inverseViewProjection * vec4(ndc, depth, 1.0);
            rasterDistance = length(world.xyz / world.w - origin);
        }
        float voxel = min(min(texelSize.x, texelSize.y), texelSize.z);
        float error = abs(t - rasterDistance) / voxel;
        if (mode == ViewAgreementData) {
            float code = hit && rasterHit ? error
                : (rasterHit ? -1.0 : (hit ? -2.0 : -3.0));
            imageStore(image, pixel, vec4(code, hit ? t : 0.0, rasterDistance, 1.0));
            return;
        }
        if (hit && rasterHit) {
            color = error <= 1.0 ? vec3(0.1, 0.8, 0.2)
                : (error <= 3.0 ? vec3(0.9, 0.8, 0.1) : vec3(0.9, 0.15, 0.1));
        } else if (rasterHit) {
            color = vec3(0.15, 0.3, 1.0);
        } else if (hit) {
            color = vec3(0.9, 0.1, 0.9);
        }
    } else if (mode == ViewSteps) {
        color = heat(float(steps) / float(maxSteps));
    } else if (hit) {
        vec3 p = origin + direction * t;
        vec3 normal = volume_normal(p, texelSize);
        if (mode == ViewNormals) {
            color = normal * 0.5 + 0.5;
        } else {
            vec3 lightDirection = normalize(vec3(0.4, 0.8, 0.3));
            float diffuse = max(dot(normal, lightDirection), 0.0);
            float sky = normal.y * 0.5 + 0.5;
            color = vec3(0.8) * (0.85 * diffuse + 0.15 * sky);
        }
    }

    imageStore(image, pixel, vec4(color, 1.0));
}
