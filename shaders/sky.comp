#version 460

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, set = 0, binding = 0) uniform image2D image;
// A 2:1 equirectangular panorama.  It maps world direction to longitude /
// latitude, avoiding a six-texture cubemap for this first skybox version.
layout(set = 0, binding = 1) uniform sampler2D skyboxTexture;

#extension GL_GOOGLE_include_directive : require
#include "environment_gradient.glsl"

layout(push_constant) uniform constants
{
    // x = 1 for the panorama, 0 for the analytic gradient
    // (traceEnvironmentMap); y = environment intensity; z = 1 for a black
    // environment.  The same selection and policy every other path uses, so
    // background pixels match the reference's camera misses (R4.9).
    vec4 data1;
    vec4 data2;
    vec4 data3;
    vec4 data4;
} PushConstants;

float hash12(vec2 p)
{
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

void main()
{
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(image);

    if (texelCoord.x < size.x && texelCoord.y < size.y)
    {
        vec2 uv = (vec2(texelCoord) + 0.5) / vec2(size);
        vec2 screen = uv * 2.0 - 1.0;
        screen.y = -screen.y;

        float aspect = float(size.x) / float(size.y);
        const float tanHalfFov = 0.70020754; // tan(70 degrees / 2)
        vec3 direction = normalize(
            PushConstants.data4.xyz +
            screen.x * aspect * tanHalfFov * PushConstants.data2.xyz +
            screen.y * tanHalfFov * PushConstants.data3.xyz);

        vec3 radiance = PushConstants.data1.x > 0.5
            ? texture(skyboxTexture, equirectangular_uv(direction)).rgb
            : gradient_radiance(direction);
        radiance = PushConstants.data1.z > 0.5
            ? vec3(0.0)
            : radiance * PushConstants.data1.y;
        imageStore(image, texelCoord, vec4(radiance, 1.0));
    }
}
