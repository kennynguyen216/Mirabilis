#version 450
#extension GL_GOOGLE_include_directive : require

// Kernel-based hemisphere ambient occlusion over the depth/normal prepass.
// It answers a different question from the shadow map: the shadow map says
// whether the sun reaches a surface, this says how much of the surrounding
// hemisphere is blocked by nearby geometry.  Only the ambient term uses it.
#include "scene_data.glsl"
#include "ssao_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// The sample count is a specialization constant, so each quality level is its
// own pipeline with its own loop bound.  A push-constant bound would leave
// one shader compiled for the maximum and merely skip the later iterations.
layout(constant_id = 0) const int KernelSize = 32;

// The prepass targets, read through the nearest/clamped sampler: filtering
// depth or normals across a silhouette invents a surface that exists nowhere.
layout(set = 1, binding = 0) uniform sampler2D prepassDepth;
layout(set = 1, binding = 1) uniform sampler2D prepassNormal;
// 16x16 tiled rotation vectors, nearest and repeating.  Rotating the kernel
// differently at neighbouring pixels turns a visible directional pattern into
// noise the bilateral blur can then remove.
layout(set = 1, binding = 2) uniform sampler2D rotationNoise;
// Deliberately declared without a format qualifier.  The engine picks the
// occlusion format from what the device advertises for storage-plus-sampled
// use, and a hard-coded qualifier here would have to match that choice.
layout(set = 1, binding = 3) uniform writeonly image2D outputAO;
layout(set = 1, binding = 4) uniform SSAOKernel {
    // xyz = a point in the +Z hemisphere, already biased towards the origin.
    vec4 samples[64];
} kernelData;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    // The dispatch is rounded up to whole workgroups and the extent is not
    // required to divide by eight.
    if (any(greaterThanEqual(pixel, PushConstants.extents.xy))) {
        return;
    }

    ivec2 centerPixel = prepass_pixel(screen_uv_for(pixel));
    vec2 screenUV = prepass_screen_uv(centerPixel);
    float depth = texelFetch(prepassDepth, centerPixel, 0).r;

    // Nothing was drawn here, so there is no surface to occlude.  Leaving the
    // background fully visible is what keeps the sky out of the effect.
    if (depth <= BackgroundDepth) {
        imageStore(outputAO, pixel, vec4(1.0));
        return;
    }

    // The prepass writes signed view-space normals into a float attachment,
    // so there is nothing to decode here.  It clears to zero, which is how a
    // pixel no surface covered is recognised.
    vec3 rawNormal = texelFetch(prepassNormal, centerPixel, 0).xyz;
    if (dot(rawNormal, rawNormal) < 1e-8) {
        imageStore(outputAO, pixel, vec4(1.0));
        return;
    }
    vec3 normal = normalize(rawNormal);
    vec3 viewPosition = view_position_from_depth(screenUV, depth);

    // Generate a decorrelated rotation for every AO pixel. The old 16x16
    // texture repeated often enough that its pattern survived the bilateral
    // blur as visible vertical columns on large, flat walls. Interleaved
    // gradient noise has no short tile boundary for the eye to pick out.
    vec2 pixelCenter = vec2(pixel) + 0.5;
    float randomUnit = fract(
        52.9829189 * fract(dot(pixelCenter, vec2(0.06711056, 0.00583715))));
    float randomAngle = randomUnit * 6.28318530718;
    vec2 rotation = vec2(cos(randomAngle), sin(randomAngle));

    // Rotate within a stable tangent plane. Projecting XY noise onto a wall
    // normal collapses many different angles to the same tangent direction.
    vec3 axis = abs(normal.z) < 0.9 ? vec3(0, 0, 1) : vec3(0, 1, 0);
    vec3 baseTangent = normalize(cross(axis, normal));
    vec3 baseBitangent = cross(normal, baseTangent);
    vec3 tangent = baseTangent * rotation.x + baseBitangent * rotation.y;
    vec3 bitangent = cross(normal, tangent);
    mat3 tangentToView = mat3(tangent, bitangent, normal);

    float radius = PushConstants.settings.x;
    float bias = PushConstants.settings.y;
    vec3 sampleOrigin = viewPosition + normal * bias;
    // Distance in front of the camera, which grows as a surface recedes.
    // The engine's view space looks down -Z.
    float centerDistance = -viewPosition.z;

    float occlusion = 0.0;
    for (int i = 0; i < KernelSize; ++i) {
        vec3 samplePosition =
            sampleOrigin + tangentToView * kernelData.samples[i].xyz * radius;

        vec4 clipPosition = sceneData.proj * vec4(samplePosition, 1.0);
        // Behind or on the plane of the camera: there is no screen position
        // to look this sample up at.
        if (clipPosition.w <= 1e-6) {
            continue;
        }
        vec2 sampleScreenUV = (clipPosition.xy / clipPosition.w) * 0.5 + 0.5;
        // A sample that left the frame has no depth to compare against.
        // Skipping it rather than counting it as blocked is what stops a dark
        // band forming along the edges of the screen.
        if (any(lessThan(sampleScreenUV, vec2(0.0))) ||
            any(greaterThan(sampleScreenUV, vec2(1.0)))) {
            continue;
        }

        ivec2 sampledPixel = prepass_pixel(sampleScreenUV);
        float sampledDepth = texelFetch(prepassDepth, sampledPixel, 0).r;
        if (sampledDepth <= BackgroundDepth) {
            continue;
        }
        // Reconstructing the position is less error-prone than comparing raw
        // reversed-depth values, which are both non-linear and inverted.
        vec3 sampledPosition =
            view_position_from_depth(prepass_screen_uv(sampledPixel), sampledDepth);

        float sampleDistance = -samplePosition.z;
        float surfaceDistance = -sampledPosition.z;
        // The surface actually visible along this ray sits nearer the camera
        // than the hemisphere point, so it blocks it.
        // A coplanar neighbour cannot occlude the outward hemisphere.
        // Keep this tolerance small so narrow contacts survive filtering.
        float planeHeight = dot(normal, sampledPosition - viewPosition);
        float tolerance = max(0.001, radius * 0.001);
        bool blocked = surfaceDistance < sampleDistance - tolerance &&
            planeHeight > tolerance;

        // Without this a distant wall would occlude a surface purely because
        // it is nearer the camera than a sample floating out in the open.
        float delta = abs(centerDistance - surfaceDistance);
        float rangeWeight = smoothstep(0.0, 1.0, radius / max(delta, 1e-4));
        occlusion += (blocked ? 1.0 : 0.0) * rangeWeight;
    }

    float visibility = 1.0 - occlusion / float(KernelSize);
    visibility = pow(clamp(visibility, 0.0, 1.0), PushConstants.settings.z);
    // Scaling the occluded part rather than the visibility keeps 1.0 neutral,
    // so intensity can never darken a surface nothing was blocking.
    visibility = 1.0 - (1.0 - visibility) * PushConstants.settings.w;
    imageStore(outputAO, pixel, vec4(clamp(visibility, 0.0, 1.0)));
}
