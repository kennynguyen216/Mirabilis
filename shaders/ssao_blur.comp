#version 450
#extension GL_GOOGLE_include_directive : require

// One direction of a separable bilateral blur over the occlusion image.  An
// ordinary blur would drag dark occlusion across a silhouette and leave a
// halo around every foreground object, so each tap is weighted by how much
// the surface under it agrees with the surface under the centre pixel.
#include "scene_data.glsl"
#include "ssao_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D inputAO;
layout(set = 1, binding = 1) uniform sampler2D prepassDepth;
layout(set = 1, binding = 2) uniform sampler2D prepassNormal;
// Unqualified for the same reason as the sampling pass: the engine chooses
// the occlusion format at startup from what the device supports.
layout(set = 1, binding = 3) uniform writeonly image2D outputAO;

const int TapRadius = 2;
// A five-tap Gaussian.  It is renormalised against the weights actually used,
// so rejecting a neighbour does not darken or brighten the result.
const float SpatialWeight[5] = float[](0.0625, 0.25, 0.375, 0.25, 0.0625);

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, PushConstants.extents.xy))) {
        return;
    }

    vec2 screenUV = screen_uv_for(pixel);
    float centerDepth = texture(prepassDepth, prepass_uv(screenUV)).r;

    // The background carries no occlusion to filter, and letting it into a
    // weighted sum would pull foreground edges towards full visibility.
    if (centerDepth <= BackgroundDepth) {
        imageStore(outputAO, pixel, vec4(1.0));
        return;
    }

    vec3 centerPosition = view_position_from_depth(screenUV, centerDepth);
    vec3 centerNormal =
        normalize(texture(prepassNormal, prepass_uv(screenUV)).xyz);

    // One occlusion texel is two full-resolution pixels, so a tap of one
    // occlusion pixel is a screen-space step of two.
    vec2 tapStep = vec2(PushConstants.extents.zw) *
        PushConstants.screenTexel.xy * 2.0;
    float depthFalloff = PushConstants.settings.x;
    float normalFalloff = PushConstants.settings.y;

    float total = 0.0;
    float totalWeight = 0.0;
    for (int tap = -TapRadius; tap <= TapRadius; ++tap) {
        // Clamped to the rendered region, so the kernel never reaches into
        // the part of the allocation this frame's render scale left untouched.
        vec2 tapScreenUV = clamp(
            screenUV + tapStep * float(tap), vec2(0.0), vec2(1.0));

        float tapDepth = texture(prepassDepth, prepass_uv(tapScreenUV)).r;
        if (tapDepth <= BackgroundDepth) {
            continue;
        }
        vec3 tapNormal =
            normalize(texture(prepassNormal, prepass_uv(tapScreenUV)).xyz);

        // How far the tap sits off the plane through the centre pixel, rather
        // than how far its depth differs.  On a floor seen at a grazing angle
        // two neighbouring rows are metres apart in depth while lying on the
        // same surface; a raw depth comparison rejects every one of them and
        // leaves the noise behind as horizontal streaks.
        vec3 tapPosition = view_position_from_depth(tapScreenUV, tapDepth);
        float planeDistance =
            abs(dot(centerNormal, tapPosition - centerPosition));
        float depthWeight = exp(-planeDistance * depthFalloff);
        // And a wall meeting a floor is a discontinuity even where the two
        // touch and their depths agree.
        float normalWeight =
            pow(max(dot(centerNormal, tapNormal), 0.0), normalFalloff);

        float weight =
            SpatialWeight[tap + TapRadius] * depthWeight * normalWeight;
        total += texture(inputAO, ao_uv(tapScreenUV)).r * weight;
        totalWeight += weight;
    }

    // The centre tap's spatial weight is never zero and it always agrees with
    // itself, so this only guards against denormals.
    float filtered = totalWeight > 1e-5
        ? total / totalWeight
        : texture(inputAO, ao_uv(screenUV)).r;
    imageStore(outputAO, pixel, vec4(clamp(filtered, 0.0, 1.0)));
}
