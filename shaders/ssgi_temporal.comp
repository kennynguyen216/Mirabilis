#version 460
#extension GL_GOOGLE_include_directive : require

#include "scene_data.glsl"
#include "ssgi_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, set = 1, binding = 0) readonly uniform image2D rawIndirectImage;
layout(set = 1, binding = 2) uniform sampler2D prepassDepth;
layout(set = 1, binding = 3) uniform sampler2D prepassNormal;
layout(set = 1, binding = 6) uniform sampler2D portalMask;
layout(set = 1, binding = 8) uniform sampler2D gbufferVelocity;
// No format qualifier: the history is RGBA32F under IQ9's static accumulation
// and RGBA16F for its control (shaderStorageImageWriteWithoutFormat).
layout(set = 1, binding = 9) writeonly uniform image2D temporalIndirectImage;
layout(rgba16f, set = 1, binding = 10) writeonly uniform image2D temporalDiagnosticImage;
layout(set = 1, binding = 11) uniform sampler2D previousTemporalIndirect;
layout(set = 1, binding = 12) uniform sampler2D previousMetadata;
layout(rgba16f, set = 1, binding = 13) writeonly uniform image2D currentMetadata;

layout(push_constant) uniform constants {
    uvec4 control;
    vec4 settings;
    vec4 temporal;
    uvec4 quality;
} PushConstants;

vec2 frame_uv(vec2 screenUV, sampler2D source)
{
    vec2 extent = vec2(PushConstants.quality.yz);
    return live_uv(ssgi_geometry_uv(screenUV, extent), source, extent);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = ivec2(PushConstants.control.xy);
    if (any(greaterThanEqual(pixel, extent))) return;

    vec2 screenUV = (vec2(pixel) + 0.5) / vec2(extent);
    vec2 geometryUV = ssgi_geometry_uv(screenUV, vec2(PushConstants.quality.yz));
    float depth = texture(prepassDepth,
        frame_uv(screenUV, prepassDepth)).r;
    if (depth <= 1e-6) {
        imageStore(temporalIndirectImage, pixel, vec4(0.0));
        imageStore(temporalDiagnosticImage, pixel,
            vec4(0.25, 0.0, 0.0, 1.0));
        imageStore(currentMetadata, pixel, vec4(0.0));
        return;
    }

    vec3 current = imageLoad(rawIndirectImage, pixel).rgb;
    vec3 normal = normalize(texture(prepassNormal,
        frame_uv(screenUV, prepassNormal)).xyz);
    vec3 worldNormal = normalize(transpose(mat3(sceneData.view)) * normal);
    vec4 projection = vec4(sceneData.proj[0][0], sceneData.proj[1][1],
        sceneData.proj[2][2], sceneData.proj[3][2]);
    vec3 position = ssgi_view_position(geometryUV, depth, projection);
    vec2 velocity = texture(gbufferVelocity,
        frame_uv(screenUV, gbufferVelocity)).xy;
    vec2 previousUV = screenUV + velocity;
    float currentPortal = texture(portalMask,
        frame_uv(screenUV, portalMask)).r;
    float rejection = 0.0;
    bool accepted = PushConstants.control.z != 0u;
    if (!accepted || any(lessThan(previousUV, vec2(0.0))) ||
        any(greaterThanEqual(previousUV, vec2(1.0)))) {
        accepted = false;
        rejection = 0.25;
    }

    vec3 history = vec3(0.0);
    float historyLength = 0.0;
    float historyWeightSum = 0.0;
    if (accepted) {
        vec4 worldPosition = sceneData.inverseViewProjection *
            vec4(geometryUV * 2.0 - 1.0, depth, 1.0);
        worldPosition /= worldPosition.w;
        vec4 previousClip = sceneData.previousViewProjection * worldPosition;
        if (previousClip.w <= 0.0) {
            accepted = false;
            rejection = 0.50;
        }
        if (length(velocity) > PushConstants.temporal.w) {
            accepted = false;
            rejection = 1.0;
        }
        if (accepted) {
            float expectedDepth = previousClip.z / previousClip.w;
            vec2 expectedUV = previousClip.xy / previousClip.w * 0.5 + 0.5;
            vec3 expectedPosition = ssgi_view_position(expectedUV, expectedDepth, projection);
            // Projection is fixed between valid history frames. Bring the
            // receiver plane into the previous camera before testing its taps.
            vec3 previousNormal = normalize(mat3(sceneData.inverseProjection *
                sceneData.previousViewProjection) * worldNormal);
            vec2 f = previousUV * vec2(extent) - 0.5;
            ivec2 base = ivec2(floor(f));
            vec2 fraction = fract(f);
            // Validate each bilinear tap before blending. Interpolated depth
            // and normals can hide a disocclusion between unrelated surfaces.
            for (int i = 0; i < 4; ++i) {
                ivec2 corner = ivec2(i & 1, i >> 1);
                ivec2 q = base + corner;
                if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, extent))) continue;
                vec4 metadata = texelFetch(previousMetadata, q, 0);
                vec2 qUV = (vec2(q) + 0.5) / vec2(extent);
                vec3 priorPosition = ssgi_view_position(ssgi_geometry_uv(qUV,
                    vec2(PushConstants.quality.yz)), metadata.r, projection);
                if (metadata.r <= 1e-6 || abs(dot(previousNormal, priorPosition - expectedPosition)) >
                    PushConstants.temporal.y * max(-expectedPosition.z, 1.0)) {
                    rejection = max(rejection, 0.50);
                    continue;
                }
                if (dot(worldNormal, decode_octahedron(metadata.gb)) < PushConstants.temporal.z) {
                    rejection = max(rejection, 0.75);
                    continue;
                }
                if (abs(metadata.a - currentPortal) > 0.5) {
                    rejection = 1.0;
                    continue;
                }
                float tapWeight = (corner.x == 1 ? fraction.x : 1.0 - fraction.x) *
                    (corner.y == 1 ? fraction.y : 1.0 - fraction.y);
                vec4 prior = texelFetch(previousTemporalIndirect, q, 0);
                history += prior.rgb * tapWeight;
                historyLength += prior.a * tapWeight;
                historyWeightSum += tapWeight;
            }
            accepted = historyWeightSum > 1e-4;
            if (accepted) {
                history /= historyWeightSum;
                historyLength /= historyWeightSum;
                rejection = 0.0;
            }
        }
    }

    vec3 result = current;
    if (accepted) {
        vec3 neighborhoodMin = vec3(1e20);
        vec3 neighborhoodMax = vec3(-1e20);
        // Screen probes (quality.w bit 0) make the raw image smooth within a probe
        // tile, so adjacent pixels agree however noisy the probe was; the
        // clamp has to span neighbouring probes to see that noise, or it pins
        // history to the current frame and nothing accumulates.
        int stride = (PushConstants.quality.w & 1u) != 0u ? 8 : 1;
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                ivec2 q = clamp(pixel + ivec2(x, y) * stride, ivec2(0), extent - 1);
                vec2 qUV = (vec2(q) + 0.5) / vec2(extent);
                float qDepth = texture(prepassDepth, frame_uv(qUV, prepassDepth)).r;
                if (qDepth <= 1e-6) continue;
                vec3 qNormal = normalize(texture(prepassNormal, frame_uv(qUV, prepassNormal)).xyz);
                if (dot(normal, qNormal) < PushConstants.temporal.z ||
                    abs(dot(normal, ssgi_view_position(ssgi_geometry_uv(qUV,
                        vec2(PushConstants.quality.yz)), qDepth, projection) - position)) >
                        PushConstants.temporal.y * max(-position.z, 1.0) ||
                    abs(texture(portalMask, frame_uv(qUV, portalMask)).r - currentPortal) > 0.5) continue;
                vec3 sampleValue = imageLoad(rawIndirectImage, q).rgb;
                neighborhoodMin = min(neighborhoodMin, sampleValue);
                neighborhoodMax = max(neighborhoodMax, sampleValue);
            }
        }
        // The clamp guards against stale history under motion.  On a still,
        // accepted reprojection it only biases: at two rays a pixel most
        // neighbourhoods of a sparse sun path are near 0, and clamping to
        // them erased half the living room's sun bounce (R4.63).  So it
        // fades in with screen motion, fully from one pixel a frame.
        // quality.w bit 4: R4.64 same-build control, clamped as before.
        float motion = (PushConstants.quality.w & 16u) != 0u ? 1.0
            : clamp(length(velocity * vec2(extent)), 0.0, 1.0);
        history = mix(history, clamp(history, neighborhoodMin, neighborhoodMax), motion);
        // IQ9 (quality.w bit 5): a still pixel accumulates towards 0.98, about
        // 50 frames; motion fades it back to the preset weight.  The control
        // keeps the preset weight exactly.
        float weight = PushConstants.temporal.x;
        if ((PushConstants.quality.w & 32u) != 0u && weight < 0.98) {
            weight = mix(0.98, weight, motion);
        }
        // Newly uncovered pixels build history gradually instead of giving
        // their first noisy sample the full settled-history weight.
        weight = min(weight, historyLength / (historyLength + 1.0));
        result = mix(current, history, clamp(weight, 0.0, 0.99));
    }

    imageStore(temporalIndirectImage, pixel,
        vec4(result, accepted ? min(historyLength + 1.0, 256.0) : 1.0));
    imageStore(temporalDiagnosticImage, pixel, vec4(
        rejection, min(length(velocity) * 20.0, 1.0),
        accepted ? 1.0 : 0.0, 1.0));
    imageStore(currentMetadata, pixel,
        vec4(depth, encode_octahedron(worldNormal), currentPortal));
}
